# Copy to .env and fill in. Never commit the real .env file.

# --- Database (MVP Build Plan Section 5; hosting per Decision Log #26) ---
# Pooled connection (via Neon's PgBouncer in production) — what the running
# app uses for every normal query at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/soccernity"
# Unpooled/direct connection — used only by `prisma migrate deploy`/`dev`.
# PgBouncer's transaction-pooling mode (Neon's default pooled endpoint) can
# interfere with the advisory locks and prepared statements Prisma Migrate
# relies on, so migrations must run against a direct connection instead.
# Locally, docker-compose's plain Postgres has no pooler in front of it, so
# DIRECT_URL can simply be set to the exact same value as DATABASE_URL — no
# functional difference locally. Only a real Neon project has genuinely
# different values for the two (Neon's dashboard gives you both a pooled
# and an unpooled connection string).
DIRECT_URL="postgresql://user:password@localhost:5432/soccernity"
# Upstash's connection string uses the `rediss://` (TLS) scheme, not
# `redis://`. Confirmed this needs zero code changes: RedisService
# (services/api/src/redis/redis.service.ts) passes the full connection
# string straight into ioredis's `Redis` constructor, and ioredis itself
# detects the `rediss://` scheme and auto-enables TLS from the URL alone
# (verified directly against node_modules/ioredis's own Redis.js and
# README, not assumed) — no `tls: {}` option or other code needs to be
# added. Once a real Upstash database exists, just paste its `rediss://`
# URL here.
REDIS_URL="redis://localhost:6379"

# --- Auth (Decision Log #7 — resolved: custom JWT, Build Plan Section 5.7) ---
JWT_SECRET="replace-me"
# Generate a real value with `openssl rand -base64 32` before any deployment —
# never the placeholder above. Decision Log #9 (hosting) is now resolved
# (Decision Log #26: Render + Neon + Upstash) — this belongs in Render's own
# environment-variable dashboard (or a synced Render "Environment Group"),
# never in a committed .env file. The same rule now applies to the real
# DATABASE_URL/DIRECT_URL/REDIS_URL values above once Neon/Upstash accounts
# exist — every value in this file that says "replace-me" or points at
# localhost is a local-dev-only placeholder; production values live in
# Render's dashboard, not here. See docs/deployment.md for the full setup
# walkthrough and render.yaml for exactly which vars Render expects to be
# set manually (`sync: false`).
# Optional overrides — sensible defaults live in code
# (services/api/src/modules/auth/token/token.constants.ts) if unset.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Password-reset token TTL (PR B4, /auth/forgot-password + /auth/reset-password).
# Not pinned by Section 5.7 (which only specifies access/refresh TTLs) —
# see services/api/src/modules/auth/README.md's Decision Log candidate note.
RESET_TOKEN_TTL_MINUTES=60

# --- Admin Console auth (Decision Log #54 — sprint-2/admin-console-account-entity) ---
# A deliberately SEPARATE signing secret from JWT_SECRET above — this is
# the actual cryptographic proof that a User access token can never
# authenticate as an admin (or vice versa), on top of AdminAccessTokenPayload
# carrying its own `aud: "admin-console"` discriminator claim. Required, no
# code-level default — same posture as JWT_SECRET (see that entry's own
# comment); admin/token/admin-token.constants.ts has sensible fallbacks
# only for the TTL overrides below, never for this secret itself. Generate
# a real, DIFFERENT value from JWT_SECRET with `openssl rand -base64 32`
# before any deployment.
ADMIN_JWT_SECRET="replace-me"
# Optional overrides — sensible defaults live in code
# (services/api/src/modules/admin/token/admin-token.constants.ts) if unset.
# Refresh TTL deliberately defaults to the stricter end of Section 5.7's
# own "7-30 days" range (not the 30 JWT_REFRESH_TTL_DAYS above defaults
# to) — admin/moderator sessions are a higher-value target than an
# ordinary fan account, so a shorter default session lifetime is a
# reasonable in-spec judgment call, not an invented number.
ADMIN_JWT_ACCESS_TTL_SECONDS=900
ADMIN_JWT_REFRESH_TTL_DAYS=7

# --- Sports data (Decision Log #6 — resolved to Highlightly on the design side by the
# figma-screen-builder "Highlightly data redesign" pass; wired here by
# sprint-4/sports-hub-highlightly-backend, services/api/src/modules/sports +
# services/api/src/sports-data) ---
# No real Highlightly account exists yet (a human action — billing/plan selection). Wired to
# activate automatically the instant a real key replaces this placeholder, same "wired but
# inactive" pattern as EMAIL_PROVIDER_API_KEY/S3_BUCKET/SENTRY_DSN below — until then, every Sports
# Hub endpoint serves cached data only (or a clear 5xx with none) rather than attempting a doomed
# real network call. Same header value works whether the key came from a direct Highlightly account
# or a RapidAPI subscription (confirmed against Highlightly's own public docs) — see
# HIGHLIGHTLY_API_HOST/SPORTS_DATA_RAPIDAPI_HOST below for the one thing that DOES change between
# the two.
SPORTS_DATA_API_KEY="replace-me-once-vendor-is-selected"
# Direct Highlightly host by default. Leave unset for that. Point this at RapidAPI's own gateway
# host instead (e.g. "https://football-highlights-api.p.rapidapi.com") ONLY if the account is a
# RapidAPI subscription rather than a direct Highlightly one — and if you do, SPORTS_DATA_RAPIDAPI_HOST
# below must also be set, since RapidAPI's gateway requires BOTH headers, unlike the direct host.
SPORTS_DATA_BASE_URL="https://soccer.highlightly.net"
# Only needed when SPORTS_DATA_BASE_URL above points at RapidAPI's gateway — sent as the
# `x-rapidapi-host` header alongside the API key. Leave unset for a direct Highlightly account.
SPORTS_DATA_RAPIDAPI_HOST=""
# Highlightly's CONFIRMED free-tier limit (per this project's own vendor-selection research). The
# real PAID-tier request budget is NOT known — this default matches only the free tier; running in
# production against a genuinely higher (or lower) paid-plan quota needs a founder decision on
# which plan to buy, then this override. See modules/sports/README.md's Decision Log candidate —
# not assumed unlimited.
HIGHLIGHTLY_DAILY_REQUEST_BUDGET=100
# Cache/refresh TTLs (seconds) — see modules/sports/README.md's "Caching / refresh strategy"
# section for the reasoning behind each default. All optional; sensible defaults live in code
# (services/api/src/modules/sports/sports.constants.ts) if unset.
SPORTS_LIVE_CACHE_TTL_SECONDS=60
SPORTS_SCHEDULED_CACHE_TTL_SECONDS=21600
SPORTS_FINISHED_CACHE_TTL_SECONDS=86400
SPORTS_STANDINGS_CACHE_TTL_SECONDS=1800
SPORTS_H2H_CACHE_TTL_SECONDS=21600
SPORTS_HIGHLIGHTS_CACHE_TTL_SECONDS=600
# Bounds how many /matches pages (each page = one real Highlightly request, up to that endpoint's
# own documented max of 100 rows/page) a single date's fixtures refresh will fetch, even if more
# pages exist — a deliberate, disclosed cap against the daily budget (see
# modules/sports/README.md).
SPORTS_DATA_MAX_REFRESH_PAGES=1

# --- Guardian consent email (MVP Build Plan Section 8.3) ---
# Decision Log #17 (Build Plan Section 9): Postmark is the chosen
# transactional email provider. Wired to activate automatically the
# instant a real Postmark server token replaces this placeholder — no
# account exists yet (billing, domain/DKIM verification are human
# actions), same as SENTRY_DSN below.
EMAIL_PROVIDER_API_KEY="replace-me"
# The "From" address on every outbound email once EMAIL_PROVIDER_API_KEY
# is live. Postmark requires the sending address to belong to a domain
# verified (SPF/DKIM) in the Postmark account — this placeholder must be
# swapped for a real address on that verified domain once the account
# exists, not left as-is alongside a real API key.
POSTMARK_FROM_EMAIL="replace-me@example.com"
# Base URL of apps/web, used to build links inside outbound emails (e.g.
# the password-reset link in PR B4). Not previously in this file — added
# because /auth/forgot-password needs it to build a usable reset link.
WEB_APP_BASE_URL="http://localhost:5173"
# Guardian.consentToken lifetime (DPIA finding R5,
# docs/sprint-1-dpia-outline-draft.md) -- 72 hours is R5's own proposed
# starting number, explicitly not backed by a security analysis and not
# yet counsel-confirmed. Overridable here without a code change, same
# pattern as RESET_TOKEN_TTL_MINUTES above.
GUARDIAN_CONSENT_TOKEN_TTL_HOURS=72
# Guardian.withdrawalToken lifetime
# (sprint-1/guardian-consent-decline-withdraw-expiry). The credential
# emailed to a guardian who asks to WITHDRAW consent they previously gave
# -- a different token, authorising the opposite action, so it gets its
# own TTL rather than sharing the one above. Same 72h default, same "a
# starting number, not a counsel-reviewed decision" caveat as R5's.
GUARDIAN_CONSENT_WITHDRAWAL_TOKEN_TTL_HOURS=72

# --- Media storage (MVP Build Plan Section 5; wired by
# sprint-5/admin-media-storage-backend — services/api/src/modules/media,
# StorageService abstraction at services/api/src/storage) ---
# S3-compatible: works unmodified against real AWS S3, Cloudflare R2,
# Backblaze B2, or DigitalOcean Spaces — no vendor chosen yet (Decision
# Log candidate, see media/README.md; Decision Log #26's own "unbundled,
# cost-aligned for a pre-launch MVP" reasoning applies here too). Wired to
# activate the instant real values replace these placeholders, same
# pattern as EMAIL_PROVIDER_API_KEY/SENTRY_DSN above — until then,
# POST /admin/media/upload returns a clear 503 rather than attempting a
# doomed real network call against literal placeholder credentials.
S3_BUCKET="replace-me"
S3_ACCESS_KEY="replace-me"
S3_SECRET_KEY="replace-me"
# Leave unset/empty for real AWS S3 (region is required there instead —
# see S3_REGION below). Set to the provider's own S3-compatible endpoint
# URL for Cloudflare R2 / Backblaze B2 / DigitalOcean Spaces / a
# self-hosted MinIO instance, e.g. Cloudflare R2's own
# "https://<account-id>.r2.cloudflarestorage.com". Setting this also
# switches the SDK to path-style addressing (<endpoint>/<bucket>/<key>),
# the more universally-compatible style across non-AWS providers.
S3_ENDPOINT=""
# Real AWS S3: a real AWS region (e.g. "us-east-1") — required there.
# Cloudflare R2 (and some other S3-compatible providers): the literal
# string "auto" is their own convention. Defaults to "auto" if unset,
# since a genuinely provider-agnostic default has to pick one — real AWS
# S3 usage MUST override this with a real region.
S3_REGION="auto"

# --- Guardian card verification (sprint-1/coppa-card-verification) ---
# Stripe, proposed default processor. Used ONLY for the small, immediately
# refunded verification charge on the guardian of an under-13 US/undeclared
# child. Card data goes browser -> Stripe directly; only PaymentIntent ids
# reach this server. Placeholders = wired but inactive: that guardian step
# fails closed with a 503. Use TEST keys until a real account exists.
STRIPE_SECRET_KEY="replace-me"
STRIPE_PUBLISHABLE_KEY="replace-me"
# Verification charge in cents (USD). Floor and default 50 (Stripe minimum).
COPPA_VERIFICATION_AMOUNT_CENTS=50

# --- Error monitoring (MVP Build Plan Section 5) ---
# No Sentry account/project exists yet — this requires a human to sign up.
# Wired to activate automatically the instant a real DSN replaces this value;
# left unset/placeholder, Sentry initialization is skipped (graceful no-op).
SENTRY_DSN="replace-me-with-real-dsn-once-account-exists"

PORT=3000
