# Copy to .env and fill in for local development. Never commit the real .env file.
#
# No apps/web env convention existed before this PR (Sprint 1, PR F3) --
# added because the signup flow's Register step needs to know where to
# send POST /auth/register (src/api/auth.ts).

# Base URL of services/api. Falls back to services/api's default local port
# (services/api/src/main.ts) if unset.
VITE_API_BASE_URL="http://localhost:3000"
