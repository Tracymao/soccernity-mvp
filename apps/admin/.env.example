# Copy to .env and fill in for local development. Never commit the real .env file.
#
# apps/admin is a separate Vite build with its own environment (CLAUDE.md,
# "Environment variables": the first time an app needs its own variable, that
# app gets its own workspace-local .env). Read in src/api/adminClient.ts and
# src/api/adminAuth.ts.

# Base URL of services/api. Falls back to services/api's default local port
# (services/api/src/main.ts) if unset. Only variables prefixed VITE_ are
# exposed to the browser bundle -- never put a secret here.
VITE_API_BASE_URL="http://localhost:3000"
