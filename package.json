{
  "name": "soccernity",
  "private": true,
  "version": "0.1.0",
  "description": "Soccernity monorepo — see CLAUDE.md and docs/ before making architectural changes.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=services/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=services/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=services/api"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@soccernity/web": {
      "react-router": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
      },
      "@testing-library/react": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
      }
    }
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "argon2@0.45.1": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true
  }
}
